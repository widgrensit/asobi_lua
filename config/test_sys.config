[
    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter => {nova_jsonlogger, #{
                    map_depth => 3,
                    term_depth => 50,
                    new_line => true
                }}
            }}
        ]}
    ]},
    {nova_auth, [
        {pbkdf2_iterations, 100000}
    ]},
    {nova, [
        {use_stacktrace, true},
        {environment, dev},
        {cowboy_configuration, #{
            port => 8084
        }},
        {dev_mode, true},
        {bootstrap_application, asobi},
        {json_lib, json},
        {plugins, [
            {pre_request, nova_request_plugin, #{
                decode_json_body => true,
                parse_qs => true
            }},
            {pre_request, nova_cors_plugin, #{
                allow_origins => <<"*">>
            }},
            {pre_request, nova_correlation_plugin, #{}}
        ]}
    ]},
    {kura, [
        {repo, asobi_repo},
        {backend, kura_backend_postgres},
        {host, "localhost"},
        {port, 5432},
        {database, "asobi_test"},
        {user, "postgres"},
        {password, "postgres"},
        {pool_size, 5}
    ]},
    {asobi, [
        {game_dir, "/app/game"}
    ]},
    {asobi_lua, []},
    {shigoto, [
        {pool, asobi_repo},
        {poll_interval, 200},
        {queues, [{~"default", 10}]},
        {fanout_queues, [{~"broadcast", 5, #{window => 120}}]}
    ]},
    {pg, [{scope, [nova_scope, asobi_presence, asobi_chat]}]}
].
