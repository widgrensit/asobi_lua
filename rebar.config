%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-

%% asobi_lua is retired. The Lua runtime it used to hold was merged into asobi
%% (widgrensit/asobi#339); this repo now carries no Erlang source of its own and
%% exists only to keep publishing ghcr.io/widgrensit/asobi_lua, so nobody's
%% `docker pull` breaks. The release keeps the name asobi_lua - same image, same
%% bin/asobi_lua, same sys.config and vm.args - but its only application is
%% asobi, whose own supervision tree starts the Lua runtime.

{shell, [{config, "./config/dev_sys.config.src"}]}.

{deps, [
    %% Pinned to a release tag, not a branch: the nightly pin bump is retired,
    %% so an unattended branch pin would drift into whatever main happened to be
    %% at build time. Bump this by hand when a new asobi release should reach
    %% the alias image.
    {asobi, {git, "https://github.com/widgrensit/asobi.git", {tag, "v0.51.4"}}},
    %% Keep cowlib on the line cowboy needs: cowboy 2.18.0 (pulled via asobi's
    %% CVE-2026-43966 bump) requires cowlib >= 2.19.0. The old "~> 2.17" cap
    %% (< 2.18.0) silently stranded cowlib at 2.17.1 against cowboy 2.18.0, a
    %% skew that compiled but broke request handling at runtime. "~> 2.19" stays
    %% past the earlier cowlib advisory (GHSA-g2wm-735q-3f56, fixed in 2.17.0).
    {cowlib, "~> 2.19"}
]}.

{relx, [
    {release, {asobi_lua, git}, [
        asobi,
        sasl
    ]},
    {mode, dev},
    {sys_config_src, "./config/dev_sys.config.src"},
    {vm_args_src, "./config/vm.args.src"}
]}.

{profiles, [
    {prod, [
        {relx, [
            {mode, prod},
            {sys_config_src, "./config/prod_sys.config.src"}
        ]}
    ]}
]}.

{project_plugins, [
    {rebar3_audit, {git, "https://github.com/Taure/rebar3_audit.git", {tag, "v0.2.7"}}},
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git", {branch, "feat/include-otp-components"}}},
    {erlfmt, "~>1.7"}
]}.

{erlfmt, [
    write,
    {files, ["rebar.config"]}
]}.
